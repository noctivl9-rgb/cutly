{
  "name": "dossier-x",
  "version": "1.0.0",
  "private": true,
  "description": "DOSSIER X — plateforme d'enquête criminelle collaborative",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "1.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "1.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
