# Local development only. Copy to .env; never commit populated secrets.
NODE_ENV=development
PORT=3000
CUTLY_HOST=127.0.0.1
CUTLY_DB_PATH=./data/cutly.sqlite
# Production only: set a PostgreSQL connection URL from the host's secret manager.
# Netlify Database provides NETLIFY_DB_URL; external PostgreSQL services can use
# CUTLY_DATABASE_URL. Prefer a pooled TLS connection URL in serverless runtimes.
CUTLY_DATABASE_URL=
NETLIFY_DB_URL=
# Netlify defaults to a small pool per function instance. Increase only after
# checking the PostgreSQL provider's connection limit.
CUTLY_DB_POOL_MAX=2
CUTLY_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Generate a fresh random 32-byte key (base64) for a new environment.
# Keep the same value across restarts/backups; never replace it for an existing DB.
CUTLY_MFA_ENCRYPTION_KEY=

# Resend transactional email. Verify sender domain and copy exact DNS records
# from the Resend dashboard before sending real mail.
RESEND_API_KEY=
CUTLY_EMAIL_FROM=

# Twilio: provide Account SID + Auth Token and either a verified E.164 From
# sender or a Messaging Service SID. Prefer the service SID if you have one.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Optional appointment/reminder SMS (each message may incur a fee).
CUTLY_SMS_APPOINTMENT_NOTIFICATIONS=false
# Optional external scheduler: POST /api/internal/notifications with Bearer token.
# Generate at least 32 random bytes; configure only in secret managers.
CUTLY_JOB_TOKEN=

# One-time bootstrap only; omit after securely creating the first admin.
CUTLY_BOOTSTRAP_ADMIN_EMAIL=
CUTLY_BOOTSTRAP_ADMIN_PASSWORD=
