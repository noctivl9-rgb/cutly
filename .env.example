# ─── DOSSIER X — variables d'environnement ───────────────────────
# Copiez ce fichier en .env pour le développement local.

# Port HTTP (Render et la plupart des hébergeurs le fournissent automatiquement)
PORT=3000

# Base de données PostgreSQL de production (Neon, Supabase, Render Postgres…).
# Laissez vide en local : un PostgreSQL embarqué (PGlite) est utilisé.
DATABASE_URL=
# Répertoire des données PGlite en local
PGLITE_DIR=./data/pglite
# Taille du pool de connexions PostgreSQL
PG_POOL_MAX=10

# Premier administrateur global, créé au démarrage si aucun compte n'existe.
# Choisissez un mot de passe long (12 caractères minimum) et ne le versionnez jamais.
DX_ADMIN_EMAIL=
DX_ADMIN_PASSWORD=

# Adresse publique PERMANENTE utilisée dans les QR codes imprimés (https, sans / final).
PUBLIC_BASE_URL=
# Passez à true UNIQUEMENT quand le domaine définitif est en place et vérifié :
# tant que ce n'est pas le cas, les planches PDF portent la mention BROUILLON.
PRINT_DOMAIN_CONFIRMED=false

# Derrière un proxy (Render, Fly, Nginx) : utilise X-Forwarded-For pour la limitation de débit.
TRUST_PROXY=1
